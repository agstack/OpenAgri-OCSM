        a                 sh:PropertyShape ;
        rdfs:isDefinedBy  ocsm:s4ener ;
        rdfs:label        "The endTime of a power sequence. If the value is available, it SHALL be denoted here. Otherwise the element SHALL be omitted.\nThe end time of a slot MAY be stated in this element. The following equation SHALL apply: endTime - startTime = defaultDuration."@en , "end time"@en ;
        sh:datatype       xsd:duration ;
        sh:description    "The endTime of a power sequence. If the value is available, it SHALL be denoted here. Otherwise the element SHALL be omitted.\nThe end time of a slot MAY be stated in this element. The following equation SHALL apply: endTime - startTime = defaultDuration."@en ;
        sh:name           "end time"@en ;
        sh:nodeKind       sh:Literal ;
        sh:path           s4ener:hasEndTime ;
        sh:pattern        "-?P((([0-9]+Y([0-9]+M)?([0-9]+D)?|([0-9]+M)([0-9]+D)?|([0-9]+D))(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S)))?)|(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S))))" .

