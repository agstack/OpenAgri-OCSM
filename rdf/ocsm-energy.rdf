    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://saref.etsi.org/saref4ener/IncentiveTableTier"/>
  </rdf:Description>
