    <rdfs:subClassOf rdf:nodeID="A143"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4ener/DataPoint"/>
    <rdfs:label xml:lang="en">Gaussian data point</rdfs:label>
    <rdfs:comment xml:lang="en">A data point whose quantity is a standard deviation.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A136">
    <owl:onProperty rdf:resource="https://saref.etsi.org/saref4ener/hasDataPoint"/>
    <owl:onClass rdf:resource="https://saref.etsi.org/saref4ener/DataPoint"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A184">
    <rdf:rest rdf:nodeID="A167"/>
    <rdf:first rdf:resource="https://saref.etsi.org/saref4ener/Pause"/>
