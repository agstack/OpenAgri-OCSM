    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Power constraint</rdfs:label>
    <rdfs:comment xml:lang="en">The actual power constraint contained in the Allowed Limit Range or Power limit.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4ener/GaussianDataPoint">
