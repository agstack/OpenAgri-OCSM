    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Power Envelope Consequence Type</rdfs:label>
    <rdfs:comment xml:lang="en">The type of consequence of limiting power, which can be Defer or Vanish.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4ener/PowerConstraint">
